rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPlatform(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.url is string && data.url.size() <= 2048
        && data.order is number
        && data.active is bool;
    }

    function isValidSettings(data) {
      return data.siteName is string && data.siteName.size() <= 200
        && data.telegramChannelUrl is string && data.telegramChannelUrl.size() <= 2048;
    }

    // Platforms collection - public read for students, schema validated writes
    match /platforms/{platformId} {
      allow read: if true;
      allow create, update: if isValidId(platformId) && isValidPlatform(incoming());
      allow delete: if isValidId(platformId);
    }

    // Settings collection - public read for student UI, schema validated writes
    match /settings/{settingsDocId} {
      allow read: if true;
      allow create, update: if isValidId(settingsDocId) && isValidSettings(incoming());
      allow delete: if false;
    }
  }
}
